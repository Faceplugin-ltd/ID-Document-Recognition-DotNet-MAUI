<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>DocumentReader.Net.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Document Reader</ApplicationTitle>
		<ApplicationId>com.faceplugin.documentreader</ApplicationId>
		<ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.faceplugin.documentreader.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<!-- Unpackaged so lib/cpu can sit beside the executable. -->
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

		<!-- Device iOS: docsdk.framework is arm64 device-only (not simulator). -->
		<CodesignKey Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Apple Development</CodesignKey>
		<DevelopmentTeam Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">F5UMQMPPB8</DevelopmentTeam>
		<CodesignProvision Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Automatic</CodesignProvision>
	</PropertyGroup>

	<ItemGroup>
		<!-- One FP master. Resizetizer uses it as the adaptive foreground and Color as the background.
		     A second ForegroundFile, or a cached background PNG of the same logo, paints the mark twice.
		     Android only: the master fills ~88% of the 108dp layer, so other apps crop it. Scale the
		     foreground to 0.57 so the mark sits at ~50% of the layer, matching the native Android icon. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#000000" />
		<MauiIcon Update="Resources\AppIcon\appicon.png" ForegroundScale="0.57" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#000000" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\**" Exclude="Resources\Images\README.md" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Camera.MAUI" Version="1.5.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android' and Exists('Platforms\Android\libs\documentreadersdk.aar')">
		<AndroidLibrary Include="Platforms\Android\libs\documentreadersdk.aar" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Content Include="Platforms\Windows\native\**\*" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-ios' and Exists('Platforms\iOS\Frameworks\docsdk.framework')">
		<NativeReference Include="Platforms\iOS\Frameworks\docsdk.framework">
			<Kind>Framework</Kind>
			<SmartLink>False</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
	</ItemGroup>

	<!-- Nested dcrcore inside docsdk must be re-signed with the app identity or device launch fails. -->
	<Target Name="SignNestedDocSdk" BeforeTargets="BeforeCodeSign" Condition="'$(TargetFramework)' == 'net8.0-ios' And Exists('$(AppBundleDir)\Frameworks\docsdk.framework')">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/Platforms/iOS/scripts/sign_nested_docsdk.sh&quot; &quot;$(AppBundleDir)&quot; &quot;$(_CodeSigningKey)&quot;" />
	</Target>

</Project>
